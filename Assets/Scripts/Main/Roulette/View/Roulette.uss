.roulette-root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

/* 円盤＋針をまとめる領域。針は円盤上端に絶対配置で重ねる。 */
.wheel-area {
    width: 420px;
    height: 420px;
    align-items: center;
    justify-content: center;
}

.roulette-wheel {
    width: 420px;
    height: 420px;
}

/* 針：すごろくのコマと同じゴールド。太い白縁取りでどのセクター色の上でも視認できる。 */
.roulette-pointer {
    position: absolute;
    top: -18px;
    font-size: 56px;
    color: rgb(235, 200, 90);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1.4px;
    -unity-text-outline-color: rgba(35, 30, 15, 0.9);
}

/* 出目の数字バッジ。キャラアイコン（.roulette-character）の子として、コイン下部中央に重ねる。
   濃紺の丸座＋白縁で、どのキャラ絵の上でも読めるようにする。親アイコンの正立・周回に追従する。 */
.roulette-number {
    position: absolute;
    bottom: 2px;
    left: 50%;
    translate: -50% 0;
    width: 26px;
    height: 26px;
    border-top-left-radius: 13px;
    border-top-right-radius: 13px;
    border-bottom-left-radius: 13px;
    border-bottom-right-radius: 13px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(250, 250, 252);
    border-right-color: rgb(250, 250, 252);
    border-top-color: rgb(250, 250, 252);
    border-bottom-color: rgb(250, 250, 252);
    background-color: rgb(45, 45, 70);
    font-size: 16px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

/* 各セクターに貼るキャラアイコン（コードで left/top・サイズ・border-radius・rotate を設定。
   サイズはセクター数に応じて重ならないよう自動計算する）。丸く切り抜き、下地のコイン
   （Painter2D 描画のゴールドリング＋白座面）の上に載せて浮かせる。未配置時は背景色がプレースホルダ。 */
.roulette-character {
    position: absolute;
    -unity-background-scale-mode: scale-and-crop;
    translate: -50% -50%;
}

/* 出目の数字。円盤の中心ハブに絶対配置で重ねる。円盤は回転するがこれは WheelArea 直下なので回らない。
   白の太縁取りで、どのセクター色・ハブ色の上でも大きく読めるようにする。 */
.roulette-result {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    font-size: 240px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: rgba(35, 30, 15, 0.9);
}

/* スピンボタンは画面左下のズームピル（Board パネル・left:16px・幅 52px）の右隣に固定する。
   円盤の表示/非表示に関わらず手番トリガーとして常にこの位置に居る。 */
.roulette-spin {
    position: absolute;
    left: 80px;
    bottom: 16px;
    width: 160px;
}

/* 画像（Roulette.png）に差し替えたスピンボタン。青ボタンの装飾（背景色・余白）を消して
   画像だけを見せる。押下時の縮小フィードバックは残す。RouletteIconLoader が画像ロード成功時に付与。
   後方で定義される .btn-accent（青背景）に負けないよう、2クラス連結で詳細度を上げている。 */
.btn-accent.roulette-spin--image {
    width: 130px;
    height: 130px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    background-color: rgba(0, 0, 0, 0);
    /* 正方形の画像を円形にくり抜く（半径＝一辺の半分）。画像の四隅は透過済み */
    border-top-left-radius: 65px;
    border-top-right-radius: 65px;
    border-bottom-left-radius: 65px;
    border-bottom-right-radius: 65px;
    overflow: hidden;
    -unity-background-scale-mode: scale-to-fit;
}

.btn-accent.roulette-spin--image:hover,
.btn-accent.roulette-spin--image:focus {
    background-color: rgba(0, 0, 0, 0);
}

.btn-accent.roulette-spin--image:active {
    background-color: rgba(0, 0, 0, 0);
    scale: 0.94 0.94;
}

.btn-accent.roulette-spin--image:disabled {
    background-color: rgba(0, 0, 0, 0);
    opacity: 0.4;
}

/* アクセントボタン（design-system.md 準拠） */
.btn-accent {
    background-color: rgb(70, 90, 180);
    color: rgb(255, 255, 255);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    font-size: 14px;
    -unity-text-align: middle-center;
}

.btn-accent:hover {
    background-color: rgb(85, 105, 198);
}

.btn-accent:focus {
    background-color: rgb(95, 115, 210);
}

.btn-accent:active {
    background-color: rgb(50, 65, 145);
    scale: 0.96 0.96;
}

.btn-accent:disabled {
    background-color: rgba(70, 90, 180, 0.4);
}
