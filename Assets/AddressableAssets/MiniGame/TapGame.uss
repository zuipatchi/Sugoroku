.tap-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgb(10, 10, 20);
    align-items: center;
    justify-content: center;
}

/* サンドバッグの絵に重なるので、地の明暗に依らず読めるよう黒フチを付ける */
.tap-count {
    position: absolute;
    color: rgb(255, 255, 255);
    font-size: 88px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
}

/* 叩く場所を示す案内。サンドバッグの下寄りに重ね、中央の連打数（.tap-count）と重ならないようにする */
.tap-hint {
    position: absolute;
    bottom: 18px;
    color: rgb(255, 226, 140);
    font-size: 40px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
}

.tap-timer {
    color: rgb(180, 180, 210);
    font-size: 40px;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

/* 全参加者の連打数を並べるスコアボード（横一列・多人数なら折り返す）。 */
.tap-scoreboard {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    width: 92%;
    margin-bottom: 16px;
}

.tap-score-chip {
    align-items: center;
    margin-left: 8px;
    margin-right: 8px;
    margin-bottom: 6px;
}

.tap-score-chip__icon {
    width: 48px;
    height: 48px;
    border-radius: 24px;
    background-color: rgb(60, 66, 92);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.2);
    -unity-background-scale-mode: scale-to-fit;
}

/* プレイヤー自身のチップは金枠で強調して、どれが自分か分かるようにする。 */
.tap-score-chip--you .tap-score-chip__icon {
    border-color: rgb(255, 210, 90);
}

.tap-score-chip__count {
    margin-top: 3px;
    color: rgb(240, 240, 255);
    font-size: 24px;
    -unity-text-align: middle-center;
}

.tap-score-chip--you .tap-score-chip__count {
    color: rgb(255, 226, 140);
}

.tap-character-area {
    width: 80%;
    max-width: 640px;
    height: 260px;
    align-items: center;
    justify-content: flex-end;
    margin-bottom: 20px;
}

.tap-character-card {
    width: 190px;
    height: 250px;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
    transform-origin: center;
}

/* サンドバッグ画像（3:2）がなるべく切れずに収まる高さにする。基準幅 540 なら 80%＝432px なので
   縦 300px でほぼ画像と同じ比率になり、cover でもほとんど切り落とされない */
.tap-play-area {
    width: 80%;
    max-width: 640px;
    height: 300px;
    align-items: center;
    justify-content: center;
}

/* 叩く場所。サンドバッグ画像（Image/MiniGame/SandBag）は TapGamePlay が
   Addressables でロードして貼る。未配置のときは下の地色がそのまま残る */
.tap-button {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgb(70, 90, 180);
    background-size: cover;
    color: rgb(255, 255, 255);
    font-size: 72px;
    border-radius: 24px;
    border-width: 0;
    overflow: hidden;
}

/* 押下・無効の状態は地色だけでなく画像にも効かせる（画像を貼ると背景色は隠れてしまうため）。 */
.tap-button:hover {
    background-color: rgb(85, 105, 198);
}

.tap-button:active {
    background-color: rgb(50, 65, 145);
    -unity-background-image-tint-color: rgb(190, 190, 190);
}

.tap-button:disabled {
    background-color: rgba(70, 90, 180, 0.35);
    color: rgba(255, 255, 255, 0.5);
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.45);
}

.tap-center {
    position: absolute;
    color: rgb(255, 255, 255);
    font-size: 96px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
}

.tap-result {
    position: absolute;
    background-color: rgb(22, 22, 35);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    padding-left: 48px;
    padding-right: 48px;
    padding-top: 40px;
    padding-bottom: 40px;
    align-items: center;
    justify-content: center;
}

.tap-result-label {
    color: rgb(240, 240, 255);
    font-size: 48px;
    -unity-text-align: middle-center;
    margin-bottom: 28px;
}

.tap-close-button {
    background-color: rgb(70, 90, 180);
    color: rgb(255, 255, 255);
    font-size: 28px;
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 14px;
    padding-bottom: 14px;
    border-radius: 12px;
    border-width: 0;
}

.tap-close-button:hover {
    background-color: rgb(85, 105, 198);
}

.tap-close-button:active {
    background-color: rgb(50, 65, 145);
    scale: 0.96 0.96;
}
