<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="TapGame.uss" />
    <ui:VisualElement name="TapRoot" class="tap-root">
        <ui:Label text="残り時間：5.0" name="TimerLabel" class="tap-timer" />
        <!-- 全参加者の連打数を横一列で逐次表示するスコアボード。チップ（アイコン＋連打数）は
             参加者数に応じて TapGamePlay が動的生成し、毎フレーム数を更新する -->
        <ui:VisualElement name="Scoreboard" class="tap-scoreboard" picking-mode="Ignore" />
        <!-- 全参加者のキャラカードを横一列に並べる。カード（自分＋相手）は参加者数に応じて
             TapGamePlay が動的生成し、その参加者が叩くたびに 1 枚ずつ弾ませる -->
        <ui:VisualElement name="CharacterArea" class="tap-character-area" picking-mode="Ignore" />
        <ui:VisualElement name="PlayArea" class="tap-play-area">
            <ui:Button name="TapButton" class="tap-button" />
            <!-- 叩く場所（サンドバッグ）の上に重ねる案内。連打数と重ならないよう下寄せに置き、
                 表示は計測中だけ（点滅は TapGamePlay が駆動する） -->
            <ui:Label text="タップ" name="TapHintLabel" class="tap-hint" picking-mode="Ignore" />
            <ui:Label text="0" name="CountLabel" class="tap-count" picking-mode="Ignore" />
            <ui:Label text="準備…" name="CenterLabel" class="tap-center" />
        </ui:VisualElement>
        <ui:VisualElement name="ResultPanel" class="tap-result">
            <ui:Label text="結果" name="ResultLabel" class="tap-result-label" />
            <!-- 順位の行（参加者ぶん）は TapGamePlay が動的生成し、連打数の多い順に並べ替える -->
            <ui:VisualElement name="ResultList" class="tap-standings" picking-mode="Ignore" />
            <ui:Label text="" name="ResultNote" class="tap-result-note" />
            <ui:Button name="CloseButton" text="進む" class="tap-close-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
