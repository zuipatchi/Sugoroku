/* 背景にジムの絵（Image/GymBackground）を敷く。画像は TapGamePlay がコードから差し込み、
   前面の文字・サンドバッグが読めるよう tint で絵だけを暗くする（未配置なら地色のまま）。 */
.tap-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgb(10, 10, 20);
    background-size: cover;
    -unity-background-image-tint-color: rgb(120, 120, 120);
    align-items: center;
    justify-content: center;
}

/* サンドバッグの絵に重なるので、地の明暗に依らず読めるよう黒フチを付ける */
.tap-count {
    position: absolute;
    color: rgb(255, 255, 255);
    font-size: 88px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
}

/* 叩く場所を示す案内。サンドバッグの下寄りに重ね、中央の連打数（.tap-count）と重ならないようにする */
.tap-hint {
    position: absolute;
    bottom: 18px;
    color: rgb(255, 226, 140);
    font-size: 40px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
}

.tap-timer {
    color: rgb(180, 180, 210);
    font-size: 40px;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

/* 全参加者の連打数を並べるスコアボード（横一列・多人数なら折り返す）。 */
.tap-scoreboard {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    width: 92%;
    margin-bottom: 16px;
}

.tap-score-chip {
    align-items: center;
    margin-left: 8px;
    margin-right: 8px;
    margin-bottom: 6px;
}

.tap-score-chip__icon {
    width: 48px;
    height: 48px;
    border-radius: 24px;
    background-color: rgb(60, 66, 92);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.2);
    -unity-background-scale-mode: scale-to-fit;
}

/* プレイヤー自身のチップは金枠で強調して、どれが自分か分かるようにする。 */
.tap-score-chip--you .tap-score-chip__icon {
    border-color: rgb(255, 210, 90);
}

.tap-score-chip__count {
    margin-top: 3px;
    color: rgb(240, 240, 255);
    font-size: 24px;
    -unity-text-align: middle-center;
}

.tap-score-chip--you .tap-score-chip__count {
    color: rgb(255, 226, 140);
}

/* 全参加者のキャラカードを横一列に並べる枠（中身は TapGamePlay が生成する）。
   下端をそろえて並べ、カードの幅・高さは人数に応じてコード側で決める。 */
.tap-character-area {
    width: 92%;
    max-width: 640px;
    height: 260px;
    flex-direction: row;
    align-items: flex-end;
    justify-content: center;
    margin-bottom: 20px;
}

/* キャラカード 1 枚。寸法は参加者数から TapGamePlay が決める（人数が増えるほど小さくする。
   カード絵は 1:1 なので枠も正方形）。絵は scale-to-fit なので枠が小さくなれば絵も一緒に縮む。 */
.tap-character-card {
    background-color: rgba(0, 0, 0, 0);
    margin-left: 4px;
    margin-right: 4px;
    -unity-background-scale-mode: scale-to-fit;
    transform-origin: center;
}

/* 自分のカードだけ金の淡いスポットを背後に敷いて、どれが自分か分かるようにする
   （カード絵は背景が透過のスチッカーなので、枠線ではなく地色で示す）。 */
.tap-character-card--you {
    background-color: rgba(255, 210, 90, 0.16);
    border-radius: 14px;
}

/* サンドバッグ画像（3:2）がなるべく切れずに収まる高さにする。基準幅 540 なら 80%＝432px なので
   縦 300px でほぼ画像と同じ比率になり、cover でもほとんど切り落とされない */
.tap-play-area {
    width: 80%;
    max-width: 640px;
    height: 300px;
    align-items: center;
    justify-content: center;
}

/* 叩く場所。サンドバッグ画像（Image/MiniGame/SandBag）は TapGamePlay が
   Addressables でロードして貼る。未配置のときは下の地色がそのまま残る */
.tap-button {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgb(70, 90, 180);
    background-size: cover;
    color: rgb(255, 255, 255);
    font-size: 72px;
    border-radius: 24px;
    border-width: 0;
    overflow: hidden;
}

/* 押下・無効の状態は地色だけでなく画像にも効かせる（画像を貼ると背景色は隠れてしまうため）。 */
.tap-button:hover {
    background-color: rgb(85, 105, 198);
}

.tap-button:active {
    background-color: rgb(50, 65, 145);
    -unity-background-image-tint-color: rgb(190, 190, 190);
}

/* 無効（カウントダウン中・結果表示中）でもサンドバッグの絵はそのまま見せる＝叩けないだけで薄くしない。
   薄くするのは画像の無い地色と文字だけ（opacity は既定テーマの半透明化を打ち消すため明示する）。 */
.tap-button:disabled {
    background-color: rgba(70, 90, 180, 0.35);
    color: rgba(255, 255, 255, 0.5);
    opacity: 1;
}

.tap-center {
    position: absolute;
    color: rgb(255, 255, 255);
    font-size: 96px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
}

.tap-result {
    position: absolute;
    background-color: rgb(22, 22, 35);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    padding-left: 48px;
    padding-right: 48px;
    padding-top: 40px;
    padding-bottom: 40px;
    align-items: center;
    justify-content: center;
}

.tap-result-label {
    color: rgb(240, 240, 255);
    font-size: 48px;
    -unity-text-align: middle-center;
    margin-bottom: 28px;
}

/* 結果パネルの順位表（全参加者ぶん）。パネル幅は中身依存なので、行が潰れないよう最小幅を持たせる
   （左右のパディング 48px×2 を足しても基準解像度 540px に収まる幅にする） */
.tap-standings {
    min-width: 400px;
    margin-bottom: 20px;
}

.tap-standing {
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 8px;
    padding-bottom: 8px;
    margin-bottom: 6px;
}

/* 自分の行は金枠で強調して、どれが自分か分かるようにする（スコアボードのチップと同じ扱い） */
.tap-standing--you {
    background-color: rgba(255, 214, 102, 0.18);
    border-color: rgba(255, 214, 102, 0.7);
}

.tap-standing__rank {
    width: 76px;
    color: rgb(240, 240, 255);
    font-size: 28px;
}

.tap-standing__name {
    flex-grow: 1;
    color: rgb(225, 228, 245);
    font-size: 24px;
}

.tap-standing__value {
    width: 120px;
    color: rgb(190, 200, 230);
    font-size: 24px;
    -unity-text-align: middle-right;
}

.tap-result-note {
    color: rgb(180, 188, 215);
    font-size: 20px;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 18px;
}

.tap-close-button {
    background-color: rgb(70, 90, 180);
    color: rgb(255, 255, 255);
    font-size: 28px;
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 14px;
    padding-bottom: 14px;
    border-radius: 12px;
    border-width: 0;
}

.tap-close-button:hover {
    background-color: rgb(85, 105, 198);
}

.tap-close-button:active {
    background-color: rgb(50, 65, 145);
    scale: 0.96 0.96;
}
