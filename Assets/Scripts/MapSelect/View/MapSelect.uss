.ms-root {
    flex-grow: 1;
    background-color: rgb(22, 22, 35);
    align-items: center;
    justify-content: space-between;
}

/* 画面上部の操作エリア。中央寄せで右上のオプションアイコンを避ける。 */
.ms-actions {
    flex-direction: row;
    justify-content: center;
    margin-top: 32px;
}

.ms-action {
    width: 200px;
    margin-left: 10px;
    margin-right: 10px;
}

/* 選択中マップの大プレビュー領域。中央に大きく盤面サムネイルとマップ名を出す。 */
.ms-preview-wrap {
    flex-grow: 1;
    width: 100%;
    align-items: center;
    justify-content: center;
}

.ms-preview {
    width: 320px;
    height: 320px;
    max-width: 80%;
    background-color: rgba(255, 255, 255, 0.04);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(255, 255, 255, 0.12);
    border-right-color: rgba(255, 255, 255, 0.12);
    border-top-color: rgba(255, 255, 255, 0.12);
    border-bottom-color: rgba(255, 255, 255, 0.12);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
}

.ms-title {
    margin-top: 16px;
    font-size: 24px;
    color: rgb(240, 240, 255);
    -unity-text-align: middle-center;
}

/* 画面下部のカード一覧エリア。背景画像の上でも視認できるよう暗い帯を敷く。 */
.ms-bottom {
    width: 100%;
    align-items: center;
    padding-top: 16px;
    padding-bottom: 20px;
    background-color: rgba(0, 0, 0, 0.5);
}

/* プレイヤー人数（自分＋CPU）のステッパー行。ラベル＋−／数値／＋。カード一覧の上に置く。 */
.ms-players {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
}

.ms-players__label {
    margin-right: 14px;
    font-size: 18px;
    color: rgb(240, 240, 255);
    -unity-text-align: middle-center;
}

/* −／数値／＋ をまとめる暗いピル。 */
.ms-stepper {
    flex-direction: row;
    align-items: center;
    background-color: rgba(22, 22, 35, 0.85);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.2);
    border-right-color: rgba(255, 255, 255, 0.2);
    border-top-color: rgba(255, 255, 255, 0.2);
    border-bottom-color: rgba(255, 255, 255, 0.2);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    padding-top: 4px;
    padding-right: 6px;
    padding-bottom: 4px;
    padding-left: 6px;
}

/* −／＋ の丸ボタン。金アクセントの文字に暗い座面。 */
.ms-stepper__btn {
    width: 40px;
    height: 40px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-left: 4px;
    margin-right: 4px;
    font-size: 24px;
    color: rgb(24, 24, 36);
    background-color: rgb(235, 200, 90);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    -unity-text-align: middle-center;
}

.ms-stepper__btn:hover {
    background-color: rgb(255, 225, 120);
}

.ms-stepper__btn:active {
    scale: 0.94 0.94;
}

.ms-stepper__btn:disabled {
    opacity: 0.3;
}

/* 現在の人数。 */
.ms-stepper__value {
    min-width: 44px;
    font-size: 26px;
    color: rgb(255, 226, 140);
    -unity-text-align: middle-center;
}

/* カードを横並び・折り返しで中央に配置する。 */
.ms-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    max-width: 90%;
}

/* マップ 1 枚分のカード（Button）。サムネイル＋名前。 */
.map-card {
    width: 110px;
    height: 138px;
    margin-left: 8px;
    margin-right: 8px;
    margin-top: 6px;
    margin-bottom: 6px;
    padding-top: 8px;
    padding-right: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
    background-color: rgba(22, 22, 35, 0.85);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(255, 255, 255, 0.2);
    border-right-color: rgba(255, 255, 255, 0.2);
    border-top-color: rgba(255, 255, 255, 0.2);
    border-bottom-color: rgba(255, 255, 255, 0.2);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    align-items: center;
    justify-content: flex-start;
    transition-property: scale, border-color;
    transition-duration: 0.1s, 0.1s;
}

.map-card:hover {
    scale: 1.04 1.04;
}

.map-card:active {
    scale: 0.97 0.97;
}

/* 選択中のカードはゴールドの枠で強調する。 */
.map-card--selected {
    border-left-color: rgb(235, 200, 90);
    border-right-color: rgb(235, 200, 90);
    border-top-color: rgb(235, 200, 90);
    border-bottom-color: rgb(235, 200, 90);
    scale: 1.04 1.04;
}

/* カードの盤面サムネイル領域（正方形）。中身は Painter2D でコード描画する。 */
.map-thumb {
    width: 90px;
    height: 90px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    background-color: rgba(255, 255, 255, 0.06);
}

.map-name {
    margin-top: 8px;
    font-size: 14px;
    color: rgb(240, 240, 255);
    -unity-text-align: middle-center;
}

/* アクセントボタン（design-system.md 準拠） */
.btn-accent {
    background-color: rgb(70, 90, 180);
    color: rgb(255, 255, 255);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    padding-top: 14px;
    padding-right: 10px;
    padding-bottom: 14px;
    padding-left: 10px;
    font-size: 22px;
    -unity-text-align: middle-center;
}

.btn-accent:hover {
    background-color: rgb(85, 105, 198);
}

.btn-accent:focus {
    background-color: rgb(95, 115, 210);
}

.btn-accent:active {
    background-color: rgb(50, 65, 145);
    scale: 0.96 0.96;
}

/* セカンダリボタン（design-system.md 準拠） */
.btn-secondary {
    background-color: rgba(22, 22, 35, 0.85);
    color: rgb(230, 230, 245);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.15);
    border-right-color: rgba(255, 255, 255, 0.15);
    border-top-color: rgba(255, 255, 255, 0.15);
    border-bottom-color: rgba(255, 255, 255, 0.15);
    padding-top: 14px;
    padding-right: 10px;
    padding-bottom: 14px;
    padding-left: 10px;
    font-size: 22px;
    -unity-text-align: middle-center;
}

.btn-secondary:hover {
    background-color: rgba(45, 45, 65, 0.9);
}

.btn-secondary:focus {
    background-color: rgba(55, 55, 78, 0.92);
}

.btn-secondary:active {
    background-color: rgba(15, 15, 25, 0.9);
    scale: 0.96 0.96;
}
