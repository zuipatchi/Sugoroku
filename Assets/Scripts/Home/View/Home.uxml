<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="Home.uss" />
    <ui:VisualElement name="HomeRoot" class="home-root">
        <!-- 固定画像 Image/HomeBackGround を全画面背景に表示。画像はコードから差し込む。
             幕は全画面を均一に覆わず、薄い全面幕＋下へ向かって少しずつ濃くなる帯を重ねて
             疑似グラデーションにする（USS にグラデーションが無いため段差の小さい帯を積む）。
             上半分は絵を見せ、ボタンが載る下部だけ濃くして文字を読ませる。 -->
        <ui:VisualElement name="HomeBackground" class="home-bg" picking-mode="Ignore">
            <ui:VisualElement name="HeroImage" class="home-bg__image" picking-mode="Ignore" />
            <ui:VisualElement name="HeroScrim" class="home-bg__scrim" picking-mode="Ignore" />
            <ui:VisualElement class="home-bg__veil home-bg__veil--b1" picking-mode="Ignore" />
            <ui:VisualElement class="home-bg__veil home-bg__veil--b2" picking-mode="Ignore" />
            <ui:VisualElement class="home-bg__veil home-bg__veil--b3" picking-mode="Ignore" />
            <ui:VisualElement class="home-bg__veil home-bg__veil--b4" picking-mode="Ignore" />
        </ui:VisualElement>
        <!-- モード選択。主＝一人で遊ぶ（金ベタ）／副＝オンラインプレイ（暗いガラス地＋金枠）／
             三次＝クレジット（同じ金枠を文字ぶんに詰めた小さいピル）の3段階で押すべき場所を分ける。 -->
        <ui:VisualElement name="ModeButtons" class="mode-buttons">
            <ui:Button text="一人で遊ぶ" name="SinglePlayerButton" class="home-button home-button--primary home-enter home-enter--d1" />
            <ui:Button text="オンラインプレイ" name="OnlineButton" class="home-button home-button--secondary home-enter home-enter--d2" />
            <ui:Button text="クレジット" name="CreditButton" class="home-credit-button home-enter home-enter--d3" />
        </ui:VisualElement>
    </ui:VisualElement>
    <!-- クレジットモーダル。既定は非表示で、CreditButton 押下でコードから display と
         表示クラス（暗幕フェード＋カードのスケールイン）を切り替える。
         XML のコメントにはハイフン 2 つを書けないので USS クラス名は載せない（Home.uss を参照）。 -->
    <ui:VisualElement name="CreditOverlay" class="credit-overlay">
        <ui:VisualElement name="CreditCard" class="credit-card">
            <ui:Label text="クレジット" class="credit-title" />
            <ui:VisualElement class="divider" />
            <ui:VisualElement class="credit-row">
                <ui:Label text="企画・デザイン" class="credit-key" />
                <ui:Label text="深田 光晴" class="credit-value" />
            </ui:VisualElement>
            <ui:VisualElement class="credit-row">
                <ui:Label text="プログラミング" class="credit-key" />
                <ui:Label text="Claude Ops" class="credit-value" />
            </ui:VisualElement>
            <ui:VisualElement class="credit-row">
                <ui:Label text="イラスト" class="credit-key" />
                <ui:Label text="nijijourney / Nano Banana2" class="credit-value" />
            </ui:VisualElement>
            <ui:VisualElement class="credit-row">
                <ui:Label text="使用技術" class="credit-key" />
                <ui:Label text="Unity 6 / VContainer / R3 / UniTask / DOTween / Live2D Cubism SDK / Unity Gaming Services" class="credit-value" />
            </ui:VisualElement>
            <ui:VisualElement class="credit-row">
                <ui:Label text="フォント" class="credit-key" />
                <ui:Label text="Noto Sans JP" class="credit-value" />
            </ui:VisualElement>
            <ui:Label text="© 2026 Dragon Family" class="credit-copyright" />
            <ui:Button text="閉じる" name="CreditCloseButton" class="home-button home-button--secondary credit-close-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
