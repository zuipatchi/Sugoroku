.test-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgb(14, 16, 28);
    align-items: center;
    justify-content: center;
}

.test-title {
    color: rgb(240, 240, 255);
    font-size: 48px;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

.test-result {
    color: rgb(180, 180, 210);
    font-size: 28px;
    -unity-text-align: middle-center;
    margin-bottom: 40px;
}

.test-count-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 32px;
}

.test-count-caption {
    color: rgb(180, 180, 210);
    font-size: 28px;
    margin-right: 20px;
}

.test-count-button {
    width: 60px;
    height: 60px;
    background-color: rgb(70, 90, 180);
    color: rgb(255, 255, 255);
    font-size: 34px;
    border-radius: 12px;
    border-width: 0;
}

.test-count-button:hover {
    background-color: rgb(85, 105, 198);
}

.test-count-button:active {
    background-color: rgb(50, 65, 145);
    scale: 0.98 0.98;
}

.test-count-button:disabled {
    background-color: rgb(45, 50, 70);
    color: rgb(110, 115, 135);
}

.test-count-value {
    min-width: 72px;
    color: rgb(240, 240, 255);
    font-size: 40px;
    -unity-text-align: middle-center;
}

.test-list {
    width: 72%;
    max-width: 560px;
    align-items: stretch;
}

.test-game-button {
    background-color: rgb(70, 90, 180);
    color: rgb(255, 255, 255);
    font-size: 34px;
    padding-top: 22px;
    padding-bottom: 22px;
    border-radius: 16px;
    border-width: 0;
    margin-top: 10px;
    margin-bottom: 10px;
}

.test-game-button:hover {
    background-color: rgb(85, 105, 198);
}

.test-game-button:active {
    background-color: rgb(50, 65, 145);
    scale: 0.98 0.98;
}
