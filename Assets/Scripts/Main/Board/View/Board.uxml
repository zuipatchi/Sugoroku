<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="Board.uss" />
    <!-- 全画面を覆うが picking-mode=Ignore で下層（ルーレット）のクリックを通す -->
    <ui:VisualElement name="BoardRoot" class="board-root" picking-mode="Ignore">
        <!-- 盤面の背後に画面全体で敷く背景画像。マップごとに BoardDefinition の BackgroundAddress を
             BoardPresenter がロードして貼る（未設定なら何も出ない）。最背面に置き、ズーム/パンには追従しない -->
        <ui:VisualElement name="BoardBackground" class="board-background" picking-mode="Ignore" />
        <!-- 外周マスとコマを絶対配置するリング領域。中央寄せ＆マージンで右上アイコンを避ける -->
        <ui:VisualElement name="BoardArea" class="board-area" picking-mode="Ignore" />
        <!-- ズーム中だけドラッグでパンするための全画面の透明層。拡大率 1.0 のときは
             BoardZoomController が picking-mode=Ignore にして下層（スピンボタン等）へ通す -->
        <ui:VisualElement name="BoardDragLayer" class="board-drag-layer" picking-mode="Ignore" />
        <!-- 全プレイヤーのネームプレート（アイコン＋名前）を横 1 行で載せる上部ヘッダー。
             中身は PlayerNameplateView が生成し、プレートのクリックで PlayerDetailModal を開く -->
        <ui:VisualElement name="PlayerHeader" class="player-header" picking-mode="Ignore" />
        <!-- 勝敗テキスト（「〔キャラ名〕の勝ち！」「相手が退出しました」）。盤面の絵の上でも読めるよう
             文字だけでなく暗いガラス地＋金枠のピルで見せる。文言が無いうちはピルごと隠す（USS の
             display:none を BoardPresenter が ShowClearMessage で開ける） -->
        <ui:VisualElement name="ClearBanner" class="board-clear" picking-mode="Ignore">
            <ui:Label text="" name="ClearLabel" class="board-clear__label" picking-mode="Ignore" />
        </ui:VisualElement>
        <!-- 手番が移るたびに「〔キャラ名〕の番」を一瞬表示するアナウンス帯。既定は透明で、
             BoardPresenter が手番の変化を購読して表示→数秒後に隠す。picking-mode=Ignore で盤面操作を通す -->
        <ui:VisualElement name="TurnBanner" class="turn-banner" picking-mode="Ignore">
            <ui:Label text="" name="TurnBannerLabel" class="turn-banner__label" picking-mode="Ignore" />
        </ui:VisualElement>
        <!-- 勝敗確定後に出す「ホームに戻る」ボタン。既定は非表示（USS）で、勝者確定時に BoardPresenter が表示する。
             コンテナは picking-mode=Ignore で盤面タップを通し、ボタンだけ反応する -->
        <ui:VisualElement name="GameOverActions" class="board-gameover-actions" picking-mode="Ignore">
            <ui:Button text="ホームに戻る" name="HomeReturnButton" class="board-home-return" />
        </ui:VisualElement>
        <!-- コマが止まったマスの画像を画面中央に一瞬拡大表示する演出。中身は BoardPresenter が制御する -->
        <ui:VisualElement name="CellPopup" class="cell-popup" picking-mode="Ignore" />
        <!-- 止まったマスの文言（「お金を落とした！」等）。イベント種別ごとに用意した文言
             （BoardCellMessageCatalog）から着地のたびに 1 つを抽選し、マス画像の下に出す。
             表示は画像ポップアップと足並みをそろえて BoardLandingPresentation が制御する -->
        <ui:Label text="" name="CellMessage" class="cell-message" picking-mode="Ignore" />
        <!-- 陣地マス占拠時に、そのコマのキャラの旗を中央に表示→縮小しながらマスへ重ねる演出。BoardPresenter が制御する -->
        <ui:VisualElement name="FlagPopup" class="flag-popup" picking-mode="Ignore" />
        <!-- お金マスに止まったときに増減額（+n / -n）を上へ浮かび上がらせる演出。BoardPresenter が制御する -->
        <ui:Label text="" name="MoneyFloat" class="money-float" picking-mode="Ignore" />
        <!-- 取得したアイテムを並べる右下の手札。中身（サムネイル）は BoardPresenter が取得のたびに足す。
             右上のオプションアイコンを避けた反対側（右下）に固定する -->
        <ui:VisualElement name="ItemHand" class="item-hand" picking-mode="Ignore" />
        <!-- ズームイン／アウトの連結ピル。左下に固定（右上のオプションアイコン・中央のスピンボタンを避ける）。
             + と − を1つの縦長カプセルに連結し、間を区切り線で分ける。中央の虫眼鏡は BoardZoomController が
             Image/lupe をロードできたときだけ表示する（未配置なら + と − が直接隣り合う） -->
        <ui:VisualElement name="ZoomControls" class="zoom-controls">
            <ui:VisualElement name="ZoomPill" class="zoom-pill">
                <ui:Button text="+" name="ZoomInButton" class="zoom-button zoom-button--top" />
                <ui:VisualElement name="ZoomMagnifier" class="zoom-pill__icon" />
                <ui:Button text="-" name="ZoomOutButton" class="zoom-button zoom-button--bottom" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- 陣地獲得アイテム使用時のマス選択ガイド。既定は非表示（USS）で、BoardPresenter が表示/非表示を切り替える。
             コンテナは picking-mode=Ignore で盤面タップ（ドラッグ層）を通し、キャンセルボタンだけ反応する -->
        <ui:VisualElement name="TerritorySelectBanner" class="territory-select" picking-mode="Ignore">
            <ui:Label text="占領するマスを選んでください" name="TerritorySelectLabel" class="territory-select__label" picking-mode="Ignore" />
            <ui:Button text="キャンセル" name="TerritorySelectCancel" class="territory-select__cancel" />
        </ui:VisualElement>
        <!-- 他プレイヤーの操作（買い物・ミニゲーム・陣地選択）を待っている間だけ出す待機表示。
             既定は非表示（USS）で、BoardPresenter が待ちの開始／終了で切り替える。
             picking-mode=Ignore で盤面操作（ズーム・パン）は通す -->
        <ui:VisualElement name="WaitingBanner" class="waiting-banner" picking-mode="Ignore">
            <ui:VisualElement name="WaitingBannerPill" class="waiting-banner__pill" picking-mode="Ignore">
                <ui:Label text="" name="WaitingBannerLabel" class="waiting-banner__label" picking-mode="Ignore" />
                <!-- 「.」は固定幅の別ラベルに分けて、増減でピルの幅が変わって横に揺れないようにする -->
                <ui:Label text="" name="WaitingBannerDots" class="waiting-banner__dots" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- 手札のアイテムをクリックしたときの詳細モーダル。既定は非表示で、ItemModalPresenter が
             開閉と中身（絵・名前・効果説明）の差し替えを行う。暗幕クリックでも閉じる -->
        <ui:VisualElement name="ItemModal" class="item-modal">
            <ui:VisualElement name="ItemModalCard" class="item-modal__card">
                <ui:VisualElement name="ItemModalImage" class="item-modal__image" />
                <ui:Label text="" name="ItemModalName" class="item-modal__name" />
                <ui:Label text="" name="ItemModalDescription" class="item-modal__description" />
                <ui:VisualElement class="item-modal__buttons">
                    <ui:Button text="使用する" name="ItemModalUseButton" class="item-modal__button item-modal__button--use" />
                    <ui:Button text="閉じる" name="ItemModalCloseButton" class="item-modal__button item-modal__button--close" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- ミニゲームアイテム使用時に、遊ぶミニゲームを選ばせるモーダル。既定は非表示で、
             MiniGameSelectPresenter が開閉とゲームボタンの生成（MiniGameSelectList）を行う。暗幕クリックでも閉じる -->
        <ui:VisualElement name="MiniGameSelectModal" class="item-modal">
            <ui:VisualElement name="MiniGameSelectCard" class="item-modal__card">
                <ui:Label text="ミニゲームを選ぶ" name="MiniGameSelectTitle" class="item-modal__name" />
                <ui:VisualElement name="MiniGameSelectList" class="minigame-select__list" />
                <ui:Button text="キャンセル" name="MiniGameSelectCancel" class="item-modal__button item-modal__button--close" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- アイテム取得マスに止まったときに開くアイテムショップ。既定は非表示で、ItemShopPresenter が開閉と
             ランダムなラインナップ（ItemShopList＝一度に2枚のカルーセル。絵・名前・効果説明・価格のカード）の生成を行う。
             買えないカードは無効表示。誤タップ防止のため暗幕クリックでは閉じず、「買わずに閉じる」ボタンでだけ閉じる -->
        <ui:VisualElement name="ItemShopModal" class="item-modal">
            <ui:VisualElement name="ItemShopCard" class="item-modal__card item-shop__card">
                <ui:Label text="アイテムショップ" name="ItemShopTitle" class="item-modal__name" />
                <!-- 買う前に手持ちが分かるよう、タイトルの下に現在の所持金を出す。金額は ItemShopPresenter が
                     開くたびに書き換える。アイコンは既定が USS 描画のコインバッジで、画像が読めたら差し替わる -->
                <ui:VisualElement name="ItemShopWallet" class="item-shop__wallet">
                    <ui:VisualElement name="ItemShopWalletIcon" class="item-shop__wallet-icon" />
                    <ui:Label text="所持金" class="item-shop__wallet-label" />
                    <ui:Label text="" name="ItemShopWalletValue" class="item-shop__wallet-value" />
                </ui:VisualElement>
                <ui:VisualElement name="ItemShopList" class="item-shop__list" />
                <ui:Button text="買わずに閉じる" name="ItemShopCancel" class="item-modal__button item-modal__button--close" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- 盤面のマスをタップしたときに開く説明モーダル。既定は非表示で、BoardCellInfoPresenter が
             開閉と中身（マスの絵・名前・効果説明・補足行）の差し替えを行う。暗幕クリックでも閉じる -->
        <ui:VisualElement name="CellInfoModal" class="item-modal">
            <ui:VisualElement name="CellInfoCard" class="item-modal__card">
                <ui:VisualElement name="CellInfoImage" class="item-modal__image" />
                <ui:Label text="" name="CellInfoName" class="item-modal__name" />
                <ui:Label text="" name="CellInfoDescription" class="item-modal__description" />
                <ui:Label text="" name="CellInfoStatus" class="cell-info__status" />
                <ui:Button text="閉じる" name="CellInfoCloseButton" class="item-modal__button item-modal__button--close" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- 上部のネームプレートをクリックしたときに開くプレイヤー詳細モーダル。既定は非表示で、
             PlayerDetailPresenter が開閉と中身（アイコン・名前・所持金・占領地・所持アイテム）の差し替えを行う。
             見せるだけなので誰の手番でも開ける。暗幕クリックでも閉じる -->
        <ui:VisualElement name="PlayerDetailModal" class="item-modal">
            <ui:VisualElement name="PlayerDetailCard" class="item-modal__card player-detail__card">
                <ui:VisualElement name="PlayerDetailAvatar" class="player-detail__avatar player-detail__avatar--empty" />
                <ui:Label text="" name="PlayerDetailName" class="item-modal__name" />
                <!-- 自分＝人間プレイヤーのときだけ PlayerDetailPresenter が表示する（既定は USS で非表示） -->
                <ui:Label text="（あなた）" name="PlayerDetailYou" class="player-detail__you" />
                <ui:VisualElement name="PlayerDetailStats" class="player-detail__stats">
                    <ui:VisualElement name="PlayerDetailMoneyRow" class="player-detail__stat">
                        <ui:VisualElement name="PlayerDetailMoneyIcon" class="player-detail__badge player-detail__badge--coin" />
                        <ui:Label text="所持金" class="player-detail__stat-label" />
                        <ui:Label text="" name="PlayerDetailMoney" class="player-detail__stat-value" />
                    </ui:VisualElement>
                    <ui:VisualElement name="PlayerDetailTerritoryRow" class="player-detail__stat">
                        <ui:VisualElement name="PlayerDetailTerritoryIcon" class="player-detail__badge player-detail__badge--flag" />
                        <ui:Label text="占領地" class="player-detail__stat-label" />
                        <ui:Label text="" name="PlayerDetailTerritory" class="player-detail__stat-value player-detail__stat-value--territory" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label text="所持アイテム" class="player-detail__section" />
                <!-- アイテム行（絵・名前・枚数）は PlayerDetailPresenter が開くたびに組み直す -->
                <ui:VisualElement name="PlayerDetailItems" class="player-detail__items" />
                <ui:Button text="閉じる" name="PlayerDetailCloseButton" class="item-modal__button item-modal__button--close player-detail__close" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
