<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="MapSelect.uss" />
    <ui:VisualElement name="MapSelectRoot" class="ms-root">
        <!-- 固定画像 Image/StageBackground を全画面背景に表示。画像はコードから差し込む。
             上に暗いスクリムを重ねて前面 UI の視認性を確保する。 -->
        <ui:VisualElement name="MapSelectBackground" class="ms-bg" picking-mode="Ignore">
            <ui:VisualElement name="BackgroundImage" class="ms-bg__image" picking-mode="Ignore" />
            <ui:VisualElement name="BackgroundScrim" class="ms-bg__scrim" picking-mode="Ignore" />
        </ui:VisualElement>
        <!-- 選択中マップの大プレビュー（盤面サムネイルをコードで Painter2D 描画）とマップ名・イベント内訳 -->
        <ui:VisualElement name="PreviewWrap" class="ms-preview-wrap">
            <ui:VisualElement name="MapPreview" class="ms-preview" picking-mode="Ignore" />
            <ui:Label name="MapTitle" class="ms-title" />
            <!-- 選択中マップのイベント内訳（総マス数＋イベント別の色チップ）。MapSelectPresenter が中身を組む -->
            <ui:Label name="MapCellCount" class="ms-cellcount" />
            <ui:VisualElement name="MapStats" class="ms-stats" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="Bottom" class="ms-bottom">
            <!-- プレイヤー人数（自分＋CPU・2〜4）のステッパー。MapSelectPresenter が値を制御する -->
            <ui:VisualElement name="PlayerCount" class="ms-players">
                <ui:Label text="プレイヤー人数" class="ms-players__label" />
                <ui:VisualElement class="ms-stepper">
                    <ui:Button text="−" name="PlayerCountMinus" class="ms-stepper__btn" />
                    <ui:Label name="PlayerCountValue" class="ms-stepper__value" />
                    <ui:Button text="＋" name="PlayerCountPlus" class="ms-stepper__btn" />
                </ui:VisualElement>
            </ui:VisualElement>
            <!-- マップのカードはコードで MapGrid に追加する -->
            <ui:VisualElement name="MapGrid" class="ms-grid" />
            <!-- 戻る／決定はカードの下＝画面下部の暗い帯の中に置く（CharacterSelect と同じ並び） -->
            <ui:VisualElement name="Actions" class="ms-actions">
                <ui:Button text="戻る" name="BackButton" class="btn-secondary ms-action" />
                <ui:Button text="決定" name="ConfirmButton" class="btn-accent ms-action" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
