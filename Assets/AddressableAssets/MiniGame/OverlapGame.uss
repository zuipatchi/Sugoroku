.overlap-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgb(12, 14, 24);
    align-items: center;
    justify-content: center;
}

.overlap-title {
    position: absolute;
    top: 24px;
    color: rgb(240, 240, 255);
    font-size: 40px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.overlap-hint {
    position: absolute;
    top: 96px;
    color: rgb(200, 205, 225);
    font-size: 24px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.overlap-timer {
    position: absolute;
    top: 140px;
    color: rgb(255, 214, 92);
    font-size: 34px;
    -unity-text-align: middle-center;
}

.overlap-choices {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    width: 92%;
}

.overlap-card {
    width: 176px;
    height: 224px;
    margin: 12px;
    padding-top: 16px;
    padding-bottom: 16px;
    background-color: rgb(30, 38, 58);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.18);
    border-radius: 18px;
    align-items: center;
    justify-content: flex-start;
}

.overlap-card:hover {
    border-color: rgba(255, 255, 255, 0.4);
    background-color: rgb(38, 48, 72);
}

.overlap-card:active {
    scale: 0.96 0.96;
}

.overlap-card:disabled {
    opacity: 0.7;
}

.overlap-card--safe {
    border-color: rgb(120, 210, 140);
    background-color: rgb(34, 58, 44);
}

.overlap-card--overlapped {
    border-color: rgb(226, 96, 110);
    background-color: rgb(64, 34, 40);
}

.overlap-card__image {
    width: 128px;
    height: 128px;
    border-radius: 12px;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}

.overlap-card__name {
    margin-top: 10px;
    color: rgb(240, 240, 255);
    font-size: 22px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.overlap-card__badges {
    position: absolute;
    top: 8px;
    left: 0;
    width: 100%;
    flex-direction: row;
    justify-content: center;
}

.overlap-card__badge {
    margin-left: 4px;
    margin-right: 4px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 3px;
    padding-bottom: 3px;
    font-size: 18px;
    color: rgb(255, 255, 255);
    border-radius: 10px;
}

.overlap-card__badge--you {
    background-color: rgba(70, 90, 180, 0.9);
}

.overlap-card__badge--cpu {
    background-color: rgba(180, 70, 90, 0.9);
}

.overlap-countdown {
    position: absolute;
    color: rgb(255, 255, 255);
    font-size: 110px;
    -unity-text-align: middle-center;
}

.overlap-result {
    position: absolute;
    background-color: rgb(22, 24, 38);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    padding-left: 48px;
    padding-right: 48px;
    padding-top: 40px;
    padding-bottom: 40px;
    align-items: center;
    justify-content: center;
}

.overlap-result__label {
    color: rgb(240, 240, 255);
    font-size: 44px;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 28px;
}

.overlap-result__label--win {
    color: rgb(255, 214, 92);
}

.overlap-result__label--lose {
    color: rgb(226, 120, 130);
}

.overlap-close-button {
    background-color: rgb(70, 90, 180);
    color: rgb(255, 255, 255);
    font-size: 28px;
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 14px;
    padding-bottom: 14px;
    border-radius: 12px;
    border-width: 0;
}

.overlap-close-button:hover {
    background-color: rgb(85, 105, 198);
}

.overlap-close-button:active {
    background-color: rgb(50, 65, 145);
    scale: 0.96 0.96;
}
