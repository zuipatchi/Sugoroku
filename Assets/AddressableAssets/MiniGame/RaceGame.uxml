<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="RaceGame.uss" />
    <ui:VisualElement name="RaceRoot" class="race-root">
        <ui:Label text="2Dレース" name="TitleLabel" class="race-title" />

        <!-- レーン（走者）は参加者数に応じて RaceGamePlay が動的生成する。FinishLine はその背面に残す -->
        <ui:VisualElement name="Track" class="race-track">
            <ui:VisualElement name="FinishLine" class="race-finish" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:Label text="3" name="CountdownLabel" class="race-countdown" />
        <ui:Label text="" name="JudgeLabel" class="race-judge" />

        <ui:VisualElement name="MeterPanel" class="race-meter" picking-mode="Ignore">
            <ui:VisualElement name="MeterBar" class="race-meter__bar" picking-mode="Ignore">
                <ui:VisualElement name="MeterGood" class="race-meter__good" picking-mode="Ignore" />
                <ui:VisualElement name="MeterGreat" class="race-meter__great" picking-mode="Ignore" />
                <ui:VisualElement name="MeterMarker" class="race-meter__marker" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label text="タップでメーターを止めろ！" class="race-meter__hint" />
        </ui:VisualElement>

        <ui:Button name="TapButton" class="race-tap-button" />

        <ui:VisualElement name="ResultPanel" class="race-result">
            <ui:Label text="結果" name="ResultLabel" class="race-result__label" />
            <!-- 順位の行（走者ぶん）は RaceGamePlay が動的生成し、順位順に並べ替える -->
            <ui:VisualElement name="ResultList" class="race-standings" picking-mode="Ignore" />
            <ui:Label text="" name="ResultNote" class="race-result__note" />
            <ui:Button name="CloseButton" text="結果を反映" class="race-close-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
