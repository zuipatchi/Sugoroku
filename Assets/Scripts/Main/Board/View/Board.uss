.board-root {
    flex-grow: 1;
}

/* 外周マス・コマを絶対配置するリング領域。サイズ・位置は BoardPresenter がグリッドの
   アスペクト比 (列-1):(行-1) に合わせてピクセルで設定する（画面比に依らずマスを均等に
   並べ、右上のオプションアイコンを上マージンで避ける）。 */
.board-area {
    position: absolute;
}

/* マス同士を結ぶ接続線を描くオーバーレイ。リング領域全面を覆い、マス・コマの背後に敷く
   （generateVisualContent + Painter2D で BoardPresenter が描画）。 */
.board-lines {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

/* 外周のマス（コードで left/top に %座標を設定し、translate で自身の中心へ合わせる）。
   width/height は隣接マスが接するよう BoardPresenter がマス間隔に合わせて動的設定する
   （ここの値はロード直後の一瞬に使われるフォールバック）。 */
.board-cell {
    position: absolute;
    width: 52px;
    height: 52px;
    translate: -50% -50%;
    align-items: center;
    justify-content: center;
    background-color: rgb(22, 22, 35);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.15);
    border-right-color: rgba(255, 255, 255, 0.15);
    border-top-color: rgba(255, 255, 255, 0.15);
    border-bottom-color: rgba(255, 255, 255, 0.15);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    -unity-text-align: middle-center;
    font-size: 16px;
    color: rgb(180, 180, 210);
}

/* スタート＝ゴールのマス */
.board-cell--goal {
    background-color: rgb(70, 90, 180);
    color: rgb(255, 255, 255);
    font-size: 13px;
}

/* 画像（アイコンアドレス）を貼ったマス。背景画像をマスに合わせて表示する。 */
.board-cell--icon {
    -unity-background-scale-mode: scale-and-crop;
}

/* 占拠された陣地マス。所有者の旗画像を全体が見えるよう収めて表示する（--icon より後に定義して上書き）。 */
.board-cell--flag {
    -unity-background-scale-mode: scale-to-fit;
}

/* 陣地マス（未占拠）。奪い合うマスであることを紫の太枠で示す。占拠されると下の owned クラスで塗られる。 */
.board-cell--territory {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(170, 140, 235);
    border-right-color: rgb(170, 140, 235);
    border-top-color: rgb(170, 140, 235);
    border-bottom-color: rgb(170, 140, 235);
}

/* あなた（p0）が占拠中の陣地マス。コマ --p0 と同じ金色で塗る。owned は --icon より後に定義して背景を上書きする。 */
.board-cell--owned-p0 {
    background-color: rgba(235, 200, 90, 0.5);
    border-left-color: rgb(255, 225, 120);
    border-right-color: rgb(255, 225, 120);
    border-top-color: rgb(255, 225, 120);
    border-bottom-color: rgb(255, 225, 120);
}

/* CPU（p1）が占拠中の陣地マス。コマ --p1 と同じ青緑で塗る。 */
.board-cell--owned-p1 {
    background-color: rgba(90, 190, 200, 0.5);
    border-left-color: rgb(140, 225, 235);
    border-right-color: rgb(140, 225, 235);
    border-top-color: rgb(140, 225, 235);
    border-bottom-color: rgb(140, 225, 235);
}

/* 全マス共通で最前面に重ねる枠画像（BoardDefinition の FrameAddress）。マス全面を覆い、
   中央は透過想定でマス画像・番号を見せる。BoardPresenter が枠画像を貼る。 */
.board-cell__frame {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

/* マスに割り当てたイベントの記号（▲進む/▼戻る/休/MG）。マス下部に小さく重ねる。 */
.board-cell__event {
    position: absolute;
    bottom: 1px;
    font-size: 10px;
    color: rgb(255, 235, 150);
    -unity-text-align: middle-center;
}

/* プレイヤーのコマ。left/top の transition で 1 マスずつ滑らかに移動する。
   同マスでの重なりを避けるため translate はコードでプレイヤーごとに設定する。
   色はプレイヤー別クラス（--p0 / --p1）で指定する。 */
.board-piece {
    position: absolute;
    width: 46px;
    height: 46px;
    align-items: center;
    justify-content: center;
    border-top-left-radius: 23px;
    border-top-right-radius: 23px;
    border-bottom-left-radius: 23px;
    border-bottom-right-radius: 23px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(0, 0, 0, 0.4);
    border-right-color: rgba(0, 0, 0, 0.4);
    border-top-color: rgba(0, 0, 0, 0.4);
    border-bottom-color: rgba(0, 0, 0, 0.4);
    transition-property: left, top;
    transition-duration: 0.15s, 0.15s;
}

/* あなたのコマ（先攻・プレイヤー 0）。従来の金色。アイコン表示時は枠線で色を残す。 */
.board-piece--p0 {
    background-color: rgb(235, 200, 90);
    border-left-color: rgb(255, 225, 120);
    border-right-color: rgb(255, 225, 120);
    border-top-color: rgb(255, 225, 120);
    border-bottom-color: rgb(255, 225, 120);
}

/* CPU のコマ（プレイヤー 1）。青緑で区別する。 */
.board-piece--p1 {
    background-color: rgb(90, 190, 200);
    border-left-color: rgb(140, 225, 235);
    border-right-color: rgb(140, 225, 235);
    border-top-color: rgb(140, 225, 235);
    border-bottom-color: rgb(140, 225, 235);
}

/* キャラアイコン（バッジ）を貼ったコマ。色背景は透過にしてバッジを見せ、
   プレイヤー色は上の枠線で残す。--p0 / --p1 より後に定義して背景色を上書きする。 */
.board-piece--icon {
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}

/* アイコン表示時は YOU / CPU ラベルを隠す（バッジ自体で見分ける）。 */
.board-piece--icon .board-piece__label {
    display: none;
}

/* コマの上に載る識別ラベル（YOU / CPU）。 */
.board-piece__label {
    font-size: 11px;
    color: rgb(30, 30, 45);
    -unity-text-align: middle-center;
}

/* 自分（YOU）のネームプレートを載せる上部ヘッダー。左右に 64px の内側余白を取り、
   右上のオプションアイコン（60×60）を避けつつ中央寄せする。 */
.player-header {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
    padding-top: 14px;
    padding-left: 64px;
    padding-right: 64px;
}

/* 自分のネームプレート。暗いカードに上辺の金アクセント（自分のコマ --p0 と同色）を載せる。 */
.board-nameplate {
    min-width: 104px;
    max-width: 168px;
    padding-top: 7px;
    padding-right: 12px;
    padding-bottom: 9px;
    padding-left: 12px;
    align-items: center;
    overflow: hidden;
    background-color: rgba(18, 18, 30, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-width: 3px;
    border-left-color: rgba(255, 255, 255, 0.15);
    border-right-color: rgba(255, 255, 255, 0.15);
    border-bottom-color: rgba(255, 255, 255, 0.15);
    border-top-color: rgb(255, 225, 120);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

/* ロールタグ（YOU）。金のピルに濃色文字を載せる（自分のコマ --p0 と同色）。 */
.board-nameplate__role {
    margin-bottom: 4px;
    padding-top: 1px;
    padding-right: 8px;
    padding-bottom: 1px;
    padding-left: 8px;
    font-size: 10px;
    color: rgb(24, 24, 36);
    background-color: rgb(235, 200, 90);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    -unity-text-align: middle-center;
}

/* キャラ名。長い名前は省略記号でクリップして横幅を守る。 */
.board-nameplate__name {
    font-size: 15px;
    color: rgb(240, 240, 255);
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    max-width: 144px;
    -unity-text-align: middle-center;
}

/* 所持金の行（コイン風バッジ＋金額）。キャラ名の下に置く。 */
.board-nameplate__money {
    flex-direction: row;
    align-items: center;
    margin-top: 5px;
}

/* コイン風の金色バッジ（グリフに頼らず USS の円で描く）。 */
.board-nameplate__coin {
    width: 13px;
    height: 13px;
    margin-right: 5px;
    background-color: rgb(240, 200, 70);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(180, 140, 30);
    border-right-color: rgb(180, 140, 30);
    border-top-color: rgb(180, 140, 30);
    border-bottom-color: rgb(180, 140, 30);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

/* 所持金の金額。3 桁区切りで表示。マイナス（借金）時は赤字にする。 */
.board-nameplate__money-value {
    font-size: 15px;
    color: rgb(255, 226, 140);
    -unity-text-align: middle-center;
}

.board-nameplate__money-value--negative {
    color: rgb(240, 130, 130);
}

/* コマが止まったマスの画像を画面中央に一瞬表示する演出のカード。
   既定は縮小＆透明。--visible が付くと等倍＆不透明へ transition でポップする。
   表示中だけ display:flex にする（BoardPresenter が制御）。 */
.cell-popup {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 220px;
    height: 220px;
    translate: -50% -50%;
    display: none;
    opacity: 0;
    scale: 0.55 0.55;
    background-color: rgba(18, 18, 30, 0.94);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgb(255, 225, 120);
    border-right-color: rgb(255, 225, 120);
    border-top-color: rgb(255, 225, 120);
    border-bottom-color: rgb(255, 225, 120);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: opacity, scale;
    transition-duration: 0.18s, 0.18s;
    transition-timing-function: ease-out, ease-out;
}

/* ポップアップの表示状態（等倍・不透明）。 */
.cell-popup--visible {
    opacity: 1;
    scale: 1 1;
}

/* 陣地マス占拠時に表示するキャラの旗。中央に出したあと対象マスへ縮小移動する演出のカード。
   left/top/scale/opacity は BoardPresenter が毎フレーム駆動する（表示中だけ display:flex）。
   基準サイズ 200px の箱を translate:-50% -50% で left/top の点に中心合わせする。 */
.flag-popup {
    position: absolute;
    width: 200px;
    height: 200px;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    display: none;
    opacity: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* お金マスに止まったときに増減額を上へ浮かび上がらせる演出のテキスト。
   opacity と translate は BoardPresenter が毎フレーム駆動する（表示中だけ display:flex）。
   読みやすさのため太字＋濃い輪郭風の縁取り色を付ける。 */
.money-float {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    display: none;
    opacity: 0;
    font-size: 54px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
}

/* 増額（MoneyUp）は緑、減額（MoneyDown）は赤で色分けする。 */
.money-float--up {
    color: rgb(120, 235, 140);
}

.money-float--down {
    color: rgb(245, 120, 120);
}

/* ズーム中だけドラッグでパンするための全画面の透明層。既定は picking-mode=Ignore で無反応。
   拡大率が 1.0 を超えたとき BoardZoomController が picking-mode=Position にして入力を拾う。 */
.board-drag-layer {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
}

/* ズームピルを置く左下のコンテナ。画面左下に固定し、スピンボタン（Roulette パネル・left:80px）が
   右隣に並ぶ。 */
.zoom-controls {
    position: absolute;
    left: 16px;
    bottom: 16px;
    flex-direction: column;
    align-items: center;
}

/* + と − を連結した1つの縦長カプセル。暗いガラス地＋金の極細枠で盤面の上に浮かせる。
   角は完全な丸端（幅の半分）にしてピル形にする。overflow:hidden で内側ボタンの角を切り抜く。 */
.zoom-pill {
    width: 52px;
    flex-direction: column;
    background-color: rgba(16, 16, 26, 0.9);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 225, 120, 0.5);
    border-right-color: rgba(255, 225, 120, 0.5);
    border-top-color: rgba(255, 225, 120, 0.5);
    border-bottom-color: rgba(255, 225, 120, 0.5);
    border-top-left-radius: 26px;
    border-top-right-radius: 26px;
    border-bottom-left-radius: 26px;
    border-bottom-right-radius: 26px;
    overflow: hidden;
}

/* ピル内の +／− ボタン。地は透明（ピルの地を見せる）で、大きな金色の記号を載せる。
   hover でその半分だけ淡く明るくなり、押下で少し沈む。 */
.zoom-button {
    width: 52px;
    height: 50px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    font-size: 32px;
    color: rgb(255, 225, 120);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1.2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
    transition-property: background-color, scale;
    transition-duration: 0.1s;
}

/* 上（＋）ボタン。下辺に区切り線を持ち、中央アイコン非表示時は − との仕切りになる。 */
.zoom-button--top {
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 225, 120, 0.28);
}

.zoom-button:hover {
    background-color: rgba(255, 225, 120, 0.14);
}

.zoom-button:active {
    scale: 0.9 0.9;
}

/* 上限・下限に達したボタンは薄く無効表示する（BoardZoomController が SetEnabled で切り替える）。 */
.zoom-button:disabled {
    opacity: 0.3;
}

/* ピル中央の虫眼鏡アイコン。既定は非表示（display:none）で、Image/lupe をロードできたときだけ
   BoardZoomController が表示する。上下に区切り線を持ち + と − を挟む飾り。 */
.zoom-pill__icon {
    display: none;
    width: 52px;
    height: 30px;
    background-color: rgba(255, 225, 120, 0.06);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(255, 225, 120, 0.28);
    border-bottom-color: rgba(255, 225, 120, 0.28);
    -unity-background-scale-mode: scale-to-fit;
}

/* 中央アイコンを表示するときは、+ ボタンの下辺の区切り線を消す（アイコン側の枠が仕切りになるため）。 */
.zoom-pill--has-icon .zoom-button--top {
    border-bottom-width: 0;
}

/* 取得したアイテムを並べる右下の手札。右上のオプションアイコン・左下のズームピルを避けて
   画面右下に固定し、アイテムを右詰め・横並びにする。多く取ると左へ伸びる。 */
.item-hand {
    position: absolute;
    right: 16px;
    bottom: 16px;
    flex-direction: row;
    justify-content: flex-end;
    align-items: flex-end;
    flex-wrap: wrap;
    max-width: 60%;
}

/* 手札の 1 つ。アイテム絵を背景に敷き、金の細枠で縁取る。左隣との間隔を少し空ける。 */
.item-hand__card {
    width: 58px;
    height: 82px;
    margin-left: 6px;
    align-items: center;
    justify-content: center;
    background-color: rgba(18, 18, 30, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 225, 120, 0.7);
    border-right-color: rgba(255, 225, 120, 0.7);
    border-top-color: rgba(255, 225, 120, 0.7);
    border-bottom-color: rgba(255, 225, 120, 0.7);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

/* 手札カード右下の枚数バッジ。同じアイテムを 2 枚以上持つときだけ「x2」のように表示する。 */
.item-hand__count {
    display: none;
    position: absolute;
    right: -5px;
    bottom: -5px;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 1px;
    padding-bottom: 1px;
    background-color: rgba(18, 18, 30, 0.95);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 225, 120, 0.7);
    border-right-color: rgba(255, 225, 120, 0.7);
    border-top-color: rgba(255, 225, 120, 0.7);
    border-bottom-color: rgba(255, 225, 120, 0.7);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    font-size: 12px;
    color: rgb(255, 225, 120);
    -unity-text-align: middle-center;
}

.item-hand__count--visible {
    display: flex;
}

/* アイテム絵が未配置のときのプレースホルダ文字（アイテム名）。 */
.item-hand__label {
    font-size: 10px;
    color: rgb(240, 226, 180);
    white-space: normal;
    -unity-text-align: middle-center;
}

/* 手札カードはクリックでアイテムモーダルを開ける。ホバーで明るく・押下で少し縮める。 */
.item-hand__card:hover {
    background-color: rgba(60, 58, 82, 0.95);
    border-left-color: rgb(255, 225, 120);
    border-right-color: rgb(255, 225, 120);
    border-top-color: rgb(255, 225, 120);
    border-bottom-color: rgb(255, 225, 120);
}

.item-hand__card:active {
    scale: 0.94 0.94;
}

/* アイテム詳細モーダルの暗幕。全画面を覆い、開いている間（--open）だけ表示してクリックを吸う。
   暗幕自身のクリックでも閉じる（ItemModalPresenter）。 */
.item-modal {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center;
    justify-content: center;
}

.item-modal--open {
    display: flex;
}

/* モーダル本体のカード。手札カードと同じ「暗いガラス地＋金の細枠」で統一する。 */
.item-modal__card {
    width: 78%;
    max-width: 420px;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 24px;
    padding-bottom: 20px;
    align-items: center;
    background-color: rgba(18, 18, 30, 0.96);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 225, 120, 0.7);
    border-right-color: rgba(255, 225, 120, 0.7);
    border-top-color: rgba(255, 225, 120, 0.7);
    border-bottom-color: rgba(255, 225, 120, 0.7);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

/* モーダル内のアイテム絵。未ロード時は --empty で隠して名前と説明だけ出す。 */
.item-modal__image {
    width: 140px;
    height: 200px;
    -unity-background-scale-mode: scale-to-fit;
}

.item-modal__image--empty {
    display: none;
}

.item-modal__name {
    margin-top: 12px;
    font-size: 20px;
    color: rgb(255, 225, 120);
}

/* 効果説明の本文。折り返して中央揃えにする。 */
.item-modal__description {
    margin-top: 8px;
    font-size: 14px;
    color: rgb(240, 226, 180);
    white-space: normal;
    -unity-text-align: middle-center;
}

.item-modal__buttons {
    flex-direction: row;
    justify-content: center;
    margin-top: 18px;
}

.item-modal__button {
    margin-left: 8px;
    margin-right: 8px;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 8px;
    padding-bottom: 8px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    font-size: 16px;
    transition-property: background-color, scale;
    transition-duration: 0.1s;
}

/* 「使用する」。金アクセントの主ボタン。 */
.item-modal__button--use {
    background-color: rgb(235, 200, 90);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    color: rgb(24, 22, 16);
}

.item-modal__button--use:hover {
    background-color: rgb(255, 225, 120);
}

.item-modal__button--use:focus {
    background-color: rgb(255, 225, 120);
}

.item-modal__button--use:active {
    background-color: rgb(255, 225, 120);
    scale: 0.96 0.96;
}

/* 「閉じる」。暗い地＋金枠の副ボタン。 */
.item-modal__button--close {
    background-color: rgba(18, 18, 30, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 225, 120, 0.7);
    border-right-color: rgba(255, 225, 120, 0.7);
    border-top-color: rgba(255, 225, 120, 0.7);
    border-bottom-color: rgba(255, 225, 120, 0.7);
    color: rgb(255, 225, 120);
}

.item-modal__button--close:hover {
    background-color: rgba(255, 225, 120, 0.14);
}

.item-modal__button--close:focus {
    background-color: rgba(255, 225, 120, 0.14);
}

.item-modal__button--close:active {
    background-color: rgba(255, 225, 120, 0.14);
    scale: 0.96 0.96;
}

/* クリア表示。リング中央に重ねる。 */
.board-clear {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    -unity-text-align: middle-center;
    font-size: 48px;
    color: rgb(235, 200, 90);
}
