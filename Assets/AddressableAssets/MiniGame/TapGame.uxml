<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="TapGame.uss" />
    <ui:VisualElement name="TapRoot" class="tap-root">
        <ui:Label text="残り時間：5.0" name="TimerLabel" class="tap-timer" />
        <!-- 全参加者の連打数を横一列で逐次表示するスコアボード。チップ（アイコン＋連打数）は
             参加者数に応じて TapGamePlay が動的生成し、毎フレーム数を更新する -->
        <ui:VisualElement name="Scoreboard" class="tap-scoreboard" picking-mode="Ignore" />
        <ui:VisualElement name="CharacterArea" class="tap-character-area">
            <ui:VisualElement name="CharacterCard" class="tap-character-card" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="PlayArea" class="tap-play-area">
            <ui:Button name="TapButton" class="tap-button" />
            <ui:Label text="0" name="CountLabel" class="tap-count" picking-mode="Ignore" />
            <ui:Label text="準備…" name="CenterLabel" class="tap-center" />
        </ui:VisualElement>
        <ui:VisualElement name="ResultPanel" class="tap-result">
            <ui:Label text="結果" name="ResultLabel" class="tap-result-label" />
            <ui:Button name="CloseButton" text="結果を反映" class="tap-close-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
