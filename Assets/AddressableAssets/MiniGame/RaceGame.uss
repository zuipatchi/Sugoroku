.race-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgb(12, 14, 24);
    align-items: center;
    justify-content: center;
}

.race-title {
    position: absolute;
    top: 24px;
    color: rgb(240, 240, 255);
    font-size: 40px;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* コース背景（Image/MiniGame/Track）は RaceGamePlay が Addressables でロードして貼る。
   未配置のときは背景画像が付かず、下の地色がそのまま見える */
.race-track {
    width: 92%;
    height: 42%;
    background-color: rgb(30, 38, 58);
    background-size: cover;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.18);
    border-radius: 18px;
    overflow: hidden;
}

.race-finish {
    position: absolute;
    left: 6%;
    top: 0;
    width: 8px;
    height: 100%;
    background-color: rgba(255, 255, 255, 0.7);
    border-left-width: 3px;
    border-right-width: 3px;
    border-color: rgba(0, 0, 0, 0.55);
}

/* レーン高さは走者数に応じて RaceGamePlay が height% で割り付ける。flex 縮小で潰れないよう固定する */
.race-lane {
    position: relative;
    width: 100%;
    flex-shrink: 0;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
}

.race-lane__tag {
    position: absolute;
    left: 8px;
    top: 8px;
    font-size: 18px;
    color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0.35);
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 2px;
    padding-bottom: 2px;
    border-radius: 8px;
}

.race-lane__tag--player {
    background-color: rgba(70, 90, 180, 0.7);
}

.race-lane__tag--cpu {
    background-color: rgba(180, 70, 90, 0.7);
}

.race-runner {
    position: absolute;
    top: 50%;
    width: 76px;
    height: 76px;
    translate: 0 -50%;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}

.race-countdown {
    position: absolute;
    color: rgb(255, 255, 255);
    font-size: 110px;
    -unity-text-align: middle-center;
}

.race-judge {
    position: absolute;
    top: 24%;
    color: rgb(255, 255, 255);
    font-size: 72px;
    -unity-text-align: middle-center;
}

.race-meter {
    position: absolute;
    bottom: 48px;
    left: 0;
    width: 100%;
    align-items: center;
}

.race-meter__bar {
    position: relative;
    width: 86%;
    height: 36px;
    background-color: rgb(22, 24, 38);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.25);
    border-radius: 8px;
    overflow: hidden;
}

.race-meter__good {
    position: absolute;
    top: 0;
    height: 100%;
    background-color: rgba(90, 150, 220, 0.55);
}

.race-meter__great {
    position: absolute;
    top: 0;
    height: 100%;
    background-color: rgba(255, 200, 70, 0.85);
}

.race-meter__marker {
    position: absolute;
    top: 0;
    width: 6px;
    height: 100%;
    translate: -50% 0;
    background-color: rgb(255, 255, 255);
}

.race-meter__hint {
    color: rgb(200, 205, 225);
    font-size: 20px;
    -unity-text-align: middle-center;
    margin-top: 12px;
}

.race-tap-button {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.race-result {
    position: absolute;
    background-color: rgb(22, 24, 38);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    padding-left: 48px;
    padding-right: 48px;
    padding-top: 40px;
    padding-bottom: 40px;
    align-items: center;
    justify-content: center;
}

.race-result__label {
    color: rgb(240, 240, 255);
    font-size: 52px;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 28px;
}

/* 順位表。パネル幅は中身依存なので、行が潰れないよう最小幅を持たせる */
.race-standings {
    min-width: 460px;
    margin-bottom: 20px;
}

.race-standing {
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 8px;
    padding-bottom: 8px;
    margin-bottom: 6px;
}

.race-standing--you {
    background-color: rgba(255, 214, 102, 0.18);
    border-color: rgba(255, 214, 102, 0.7);
}

.race-standing__rank {
    width: 76px;
    color: rgb(240, 240, 255);
    font-size: 28px;
}

.race-standing__name {
    flex-grow: 1;
    color: rgb(225, 228, 245);
    font-size: 24px;
}

.race-standing__time {
    width: 130px;
    color: rgb(190, 200, 230);
    font-size: 24px;
    -unity-text-align: middle-right;
}

.race-result__note {
    color: rgb(180, 188, 215);
    font-size: 20px;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 18px;
}

.race-close-button {
    background-color: rgb(70, 90, 180);
    color: rgb(255, 255, 255);
    font-size: 28px;
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 14px;
    padding-bottom: 14px;
    border-radius: 12px;
    border-width: 0;
}

.race-close-button:hover {
    background-color: rgb(85, 105, 198);
}

.race-close-button:active {
    background-color: rgb(50, 65, 145);
    scale: 0.96 0.96;
}
