.test-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgb(14, 16, 28);
    align-items: center;
    justify-content: center;
}

.test-title {
    color: rgb(240, 240, 255);
    font-size: 48px;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

.test-result {
    color: rgb(180, 180, 210);
    font-size: 28px;
    -unity-text-align: middle-center;
    margin-bottom: 40px;
}

.test-list {
    width: 72%;
    max-width: 560px;
    align-items: stretch;
}

.test-game-button {
    background-color: rgb(70, 90, 180);
    color: rgb(255, 255, 255);
    font-size: 34px;
    padding-top: 22px;
    padding-bottom: 22px;
    border-radius: 16px;
    border-width: 0;
    margin-top: 10px;
    margin-bottom: 10px;
}

.test-game-button:hover {
    background-color: rgb(85, 105, 198);
}

.test-game-button:active {
    background-color: rgb(50, 65, 145);
    scale: 0.98 0.98;
}
