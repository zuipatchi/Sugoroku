.ocs-root {
    flex-grow: 1;
    background-color: rgb(22, 22, 35);
}

/* 選択中キャラの立ち絵を全画面背景に表示する。scale-and-crop で画面を埋める。
   画像未配置時・未選択時は backgroundColor のプレースホルダをコードで設定する。 */
.ocs-portrait {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgb(22, 22, 35);
    -unity-background-scale-mode: scale-and-crop;
}

/* 見出し（上）とカード・操作（下）を上下に分ける。 */
.ocs-foreground {
    flex-grow: 1;
    justify-content: space-between;
    align-items: center;
}

/* 画面上部の見出し。中央寄せで右上のオプションアイコンを避ける。 */
.ocs-header {
    align-items: center;
    margin-top: 40px;
}

.ocs-title {
    font-size: 28px;
    color: rgb(240, 240, 255);
    -unity-text-align: middle-center;
}

.ocs-status {
    margin-top: 8px;
    font-size: 16px;
    color: rgb(200, 205, 230);
    -unity-text-align: middle-center;
}

/* 画面下部。カードと操作ボタンをまとめて暗い帯に載せる。 */
.ocs-bottom {
    width: 100%;
    align-items: center;
    padding-top: 16px;
    padding-bottom: 24px;
    background-color: rgba(0, 0, 0, 0.5);
}

/* カードを横並び・折り返しで中央に配置する。 */
.ocs-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    max-width: 92%;
}

/* キャラ 1 枚分のカード（Button）。アイコン＋名前＋ロックバッジ。 */
.ocs-card {
    width: 100px;
    height: 128px;
    margin-left: 8px;
    margin-right: 8px;
    margin-top: 6px;
    margin-bottom: 6px;
    padding-top: 8px;
    padding-right: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
    background-color: rgba(22, 22, 35, 0.85);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(255, 255, 255, 0.2);
    border-right-color: rgba(255, 255, 255, 0.2);
    border-top-color: rgba(255, 255, 255, 0.2);
    border-bottom-color: rgba(255, 255, 255, 0.2);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    align-items: center;
    justify-content: flex-start;
    transition-property: scale, border-color, opacity;
    transition-duration: 0.1s, 0.1s, 0.1s;
}

.ocs-card:hover {
    scale: 1.04 1.04;
}

.ocs-card:active {
    scale: 0.97 0.97;
}

/* 自分が選択中のカードはゴールドの枠で強調する。 */
.ocs-card--selected {
    border-left-color: rgb(235, 200, 90);
    border-right-color: rgb(235, 200, 90);
    border-top-color: rgb(235, 200, 90);
    border-bottom-color: rgb(235, 200, 90);
    scale: 1.04 1.04;
}

/* 自分にロック（確定）されたカードは緑の枠で示す。 */
.ocs-card--mine {
    border-left-color: rgb(120, 210, 130);
    border-right-color: rgb(120, 210, 130);
    border-top-color: rgb(120, 210, 130);
    border-bottom-color: rgb(120, 210, 130);
}

/* 他プレイヤーにロックされたカードは暗くして選べない見た目にする。 */
.ocs-card--locked {
    opacity: 0.4;
}

.ocs-card__icon {
    width: 76px;
    height: 76px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    background-color: rgba(255, 255, 255, 0.06);
    -unity-background-scale-mode: scale-to-fit;
}

.ocs-card__name {
    margin-top: 8px;
    font-size: 14px;
    color: rgb(240, 240, 255);
    -unity-text-align: middle-center;
}

/* 「取得済み」バッジ。ロックされたカードにだけコードで表示する。 */
.ocs-card__lock {
    position: absolute;
    top: 40px;
    font-size: 13px;
    color: rgb(255, 235, 235);
    background-color: rgba(180, 60, 60, 0.85);
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 8px;
    padding-right: 8px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    -unity-text-align: middle-center;
}

.ocs-actions {
    flex-direction: row;
    justify-content: center;
    margin-top: 16px;
}

.ocs-action {
    width: 200px;
    margin-left: 10px;
    margin-right: 10px;
}

/* アクセントボタン（design-system.md 準拠） */
.btn-accent {
    background-color: rgb(70, 90, 180);
    color: rgb(255, 255, 255);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    padding-top: 14px;
    padding-right: 10px;
    padding-bottom: 14px;
    padding-left: 10px;
    font-size: 22px;
    -unity-text-align: middle-center;
}

.btn-accent:hover {
    background-color: rgb(85, 105, 198);
}

.btn-accent:active {
    background-color: rgb(50, 65, 145);
    scale: 0.96 0.96;
}

.btn-accent:disabled {
    background-color: rgba(70, 90, 180, 0.35);
    color: rgba(255, 255, 255, 0.5);
}

/* セカンダリボタン（design-system.md 準拠） */
.btn-secondary {
    background-color: rgba(22, 22, 35, 0.85);
    color: rgb(230, 230, 245);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.15);
    border-right-color: rgba(255, 255, 255, 0.15);
    border-top-color: rgba(255, 255, 255, 0.15);
    border-bottom-color: rgba(255, 255, 255, 0.15);
    padding-top: 14px;
    padding-right: 10px;
    padding-bottom: 14px;
    padding-left: 10px;
    font-size: 22px;
    -unity-text-align: middle-center;
}

.btn-secondary:hover {
    background-color: rgba(45, 45, 65, 0.9);
}

.btn-secondary:active {
    background-color: rgba(15, 15, 25, 0.9);
    scale: 0.96 0.96;
}
